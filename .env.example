# Copy this file to .env and fill in the values.
# Never commit .env to version control.

# Application
APP_TITLE="Lanyard Auth Service"
APP_VERSION="0.2.0"

# Database (PostgreSQL)
DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/lanyard

# JWT
ISSUER=http://localhost:8000
KEY_ID=auth-key-1
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Key paths (relative to project root)
PRIVATE_KEY_PATH=private.pem
PUBLIC_KEY_PATH=public.pem

# Rate Limiting & Redis
RATE_LIMIT_ENABLED=true
REDIS_URL=redis://localhost:6379/0
RATE_LIMIT_LOGIN=10/minute
RATE_LIMIT_REGISTER=5/minute
RATE_LIMIT_REFRESH=30/minute
RATE_LIMIT_LOGOUT=20/minute
RATE_LIMIT_APPS=5/minute
